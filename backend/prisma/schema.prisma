datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(cuid())
  email String @unique
  password String
  role String @default("READER")
  wallet String?
  books Book[]
  payments Payment[]
}

model Book {
  id String @id @default(cuid())
  title String
  description String
  price Float
  coverUrl String
  fileUrl String
  isLive Boolean @default(false)
  author User @relation(fields: [authorId], references: [id])
  authorId String
}

model Payment {
  id String @id @default(cuid())
  type String
  invoiceId String @unique
  authorId String
  bookId String?
}
