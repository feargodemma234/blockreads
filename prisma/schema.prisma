model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("READER") // READER or AUTHOR
  wallet    String?  // USDT wallet for payouts
  books     Book[]
  payments  Payment[]
}

model Book {
  id          String  @id @default(cuid())
  title       String
  description String
  price       Float
  coverUrl    String
  fileUrl     String
  isLive      Boolean @default(false)
  author      User    @relation(fields: [authorId], references: [id])
  authorId    String
}

model Payment {
  id        String @id @default(cuid())
  type      String // LISTING or SALE
  invoiceId String @unique
  authorId  String
  bookId    String?
}